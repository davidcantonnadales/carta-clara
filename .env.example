APP_URL=http://127.0.0.1:3000
DATA_DIR=./data
# Registro habilitado por defecto solo en localhost. Activar expresamente en un servidor.
ENABLE_SIGNUP=false
# Clave solo de servidor. Sin ella, el editor manual y el QR siguen funcionando.
GEMINI_API_KEY=
# Modelo configurable: confirma disponibilidad en tu cuenta antes de utilizarlo.
GEMINI_MODEL=gemini-3.8-flash
